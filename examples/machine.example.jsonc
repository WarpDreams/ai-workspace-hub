// ---------------------------------------------------------------------------
// machine.example.jsonc — annotated reference of EVERY option.
//
// The manifest lives in your CONTENT repo (next to instructions/, skills/,
// mcp/), not in the awh tool repo. Copy one of these examples there as
// `.awh.jsonc`, then point awh at it:
//
//     ln -s ~/works/my-agent-content/.awh.jsonc ~/.awh.jsonc
//     awh doctor && awh install
// ---------------------------------------------------------------------------
{
  // Optional. Directories scanned recursively for content — absolute,
  // ~-prefixed, or relative to THIS file's directory. Default ["."].
  // Recognised by shape: a dir with SKILL.md is a skill; .md files under a
  // dir named `instructions` are fragments; .json(c) under a dir named `mcp`
  // are MCP specs. On name clashes the LATER path wins (doctor warns).
  "content_search_paths": ["."],

  // Optional. Colourise `doctor` output (default false). Ignored when stdout
  // is not a terminal or $NO_COLOR is set.
  "color_output": false,

  // Optional. Applied to every target unless the target overrides them.
  "defaults": {
    // "symlink" (default): one copy on disk in this repo; agents read via a
    //   link. Editing repo content updates every agent immediately.
    // "copy": materialize independent copies. Portable; re-run `sync` to update.
    "strategy": "symlink",

    // Instruction fragments to install: discovered names (file name sans
    // .md), or paths to .md files (absolute, ~, or relative to this file).
    // For single-file agents (Claude/Codex) multiple
    // fragments are composed into one file; for Kiro each fragment becomes
    // its own steering/<name>.md.
    "instructions": ["applus_base"],

    // "*" installs every discovered skill, or list names / paths to skill
    // directories (each must contain SKILL.md).
    "skills": "*",

    // MCP servers, added through each agent's own CLI (`claude mcp add-json`,
    // `codex mcp add`, `kiro-cli mcp add`); hosted servers open a browser
    // login during install. "*" (every discovered spec), or a list mixing
    // "*", discovered names, paths to spec files, and inline declarations
    // { "<name>": { ...spec } } (same fields as a spec file; inline wins over
    // a discovered spec of the same name). Default [].
    "mcp": [
      "context7",
      "notion",
      { "playwright": { "command": "npx", "args": ["@playwright/mcp@latest"] } }
    ]
  },

  // One entry per (agent, home). Repeat an agent for multiple homes.
  "targets": [
    {
      "agent": "codex", // one of: claude | codex | kiro
      "home": "~/.codex", // agent home dir; leading ~ is expanded

      // Optional identifier. Shown in status/plan/doctor output to tell
      // multiple homes of one agent apart, and used by
      // `awh launch <name> [args...]`, which starts this target's CLI with its
      // home env var set (CODEX_HOME here; CLAUDE_CONFIG_DIR for claude,
      // KIRO_HOME for kiro). A target without a name is launched by its agent
      // id. Launch names must be unique: two targets for the same agent need
      // at least one explicit, distinct name.
      "name": "codex",

      // Optional. What `launch` runs instead of the bare agent executable
      // (claude | codex | kiro-cli): a shell-style string, or an array of
      // them run in order — all but the last are pre-steps that must succeed,
      // the last is the agent and gets the args you pass to `awh launch`.
      //   "commandline": "codex -p bedrock"
      //   "commandline": ["aws sso login --profile bedrock", "codex -p bedrock"]

      // Any of these override the defaults for this target only:
      "strategy": "symlink",
      "instructions": ["applus_base"],
      "skills": "*",
      "mcp": ["playwright"]

      // "disabled": true  // parse but skip install/sync for this target
    },

    // A second Codex home using a profile; `awh launch codex_bedrock --full-auto`
    // runs `aws sso login --profile bedrock` and then
    // `CODEX_HOME=~/.codex-bedrock codex -p bedrock --full-auto`.
    {
      "agent": "codex",
      "home": "~/.codex-bedrock",
      "name": "codex_bedrock",
      "commandline": ["aws sso login --profile bedrock", "codex -p bedrock"]
    }
  ]
}
