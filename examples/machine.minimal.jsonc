// machine.minimal.jsonc — a single Claude + single Codex home, all defaults.
// Put this in your content repo as .awh.jsonc, beside instructions/, skills/, mcp/.
{
  "defaults": {
    "strategy": "symlink",
    "instructions": ["base"],
    "skills": "*"
  },
  "targets": [
    { "agent": "claude", "home": "~/.claude" },
    { "agent": "codex", "home": "~/.codex" }
  ]
}
