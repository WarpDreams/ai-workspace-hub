// machine.macos-multi-codex.jsonc
// Matches a machine with two Codex homes plus Claude and Kiro.
{
  "defaults": {
    "strategy": "symlink",
    "instructions": ["applus_base"],
    "skills": "*"
  },
  "targets": [
    { "agent": "codex", "home": "~/.codex", "name": "codex" },

    // A secondary Codex home that only needs one skill.
    {
      "agent": "codex",
      "home": "~/.codex-backup",
      "name": "codex_backup",
      "skills": ["confluence-upload"]
    },

    { "agent": "claude", "home": "~/.claude", "name": "claude" },
    { "agent": "kiro", "home": "~/.kiro", "name": "kiro" }
  ]
}
