{
  "name": "ai-workspace-hub",
  "version": "0.3.1",
  "description": "awh: install canonical agent instructions, skills and MCP servers into Claude Code, Codex and Kiro homes from a per-machine manifest, and launch agents against a chosen home.",
  "keywords": [
    "claude-code",
    "codex",
    "kiro",
    "mcp",
    "agent",
    "skills",
    "instructions",
    "dotfiles",
    "cli",
    "awh"
  ],
  "homepage": "https://github.com/WarpDreams/ai-workspace-hub#readme",
  "bugs": {
    "url": "https://github.com/WarpDreams/ai-workspace-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WarpDreams/ai-workspace-hub.git"
  },
  "license": "MIT",
  "author": "Jian Shen <alienbat@gmail.com>",
  "type": "module",
  "bin": {
    "awh": "dist/cli.cjs"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --main-fields=module,main --define:__AWH_VERSION__=\\\"$npm_package_version\\\" --outfile=dist/cli.cjs --banner:js='#!/usr/bin/env node' && chmod +x dist/cli.cjs",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "awh": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.5.4"
  }
}
